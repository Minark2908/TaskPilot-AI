# ── Backend Configuration ────────────────────────────────────────────────────
# App Settings
PROJECT_NAME="Mini AI Project Manager Assistant"
API_V1_STR="/api/v1"

# Database Configuration
# SQLite local file path (relative to backend folder or absolute path)
DATABASE_URL="sqlite:///./project_manager.db"

# CORS Configuration (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Gemini LLM Configuration
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
# Supported models: gemini-2.5-flash, gemini-2.5-pro, etc.
LLM_MODEL="gemini-2.5-flash"
LLM_TIMEOUT=60.0

# ── Frontend Configuration ───────────────────────────────────────────────────
# Base URL for the FastAPI backend API
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
